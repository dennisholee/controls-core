# Policy Information Point image.
FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/pip ./pip/cmd/pip

FROM alpine:3.20
RUN apk add --no-cache ca-certificates \
 && adduser -D -u 10001 controls
COPY --from=build /out/pip /usr/local/bin/pip
USER controls
ENTRYPOINT ["/usr/local/bin/pip"]
