# Tools image for the centrally managed pipeline.
#
# Build:
#   docker build -f deploy/Dockerfile.tools -t controls-tools .
# Publish by digest and pin that digest in the Jenkinsfile.

FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/bundle ./tools/bundle \
 && CGO_ENABLED=0 go build -o /out/conformance ./tools/conformance \
 && CGO_ENABLED=0 go build -o /out/openapi-diff ./tools/openapi-diff \
 && CGO_ENABLED=0 go build -o /out/openapi-registry ./tools/openapi-registry \
 && CGO_ENABLED=0 go build -o /out/controls-check ./tools/controls-check \
 && CGO_ENABLED=0 go build -o /out/bundle-sign ./tools/bundle-sign \
 && CGO_ENABLED=0 go build -o /out/bundle-keygen ./tools/bundle-keygen

FROM alpine:3.20
RUN apk add --no-cache ca-certificates \
 && adduser -D -u 10001 controls \
 && mkdir -p /work \
 && chown controls /work
COPY --from=build /out/ /usr/local/bin/
WORKDIR /work
USER controls
ENTRYPOINT ["/usr/local/bin/bundle"]
