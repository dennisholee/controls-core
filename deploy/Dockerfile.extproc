# Envoy ext_proc service image. Envoy itself is a separate container.
FROM golang:1.26@sha256:cfa27959837144bf4649802ba38e59daffd0dd2a7994aa83daaf113285b0f551 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/extproc ./sidecar/cmd/extproc

FROM alpine:3.24@sha256:3f4d6b32e26703c6082839234f43769d5046b3ac7c910033911d1e71d8cd630a
RUN apk add --no-cache ca-certificates \
 && adduser -D -u 10001 controls
COPY --from=build /out/extproc /usr/local/bin/extproc
USER controls
ENTRYPOINT ["/usr/local/bin/extproc"]
