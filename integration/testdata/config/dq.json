{
  "version": "1.0",
  "rules": [
    {
      "id": "payment.amount.required",
      "resourceType": "payment",
      "field": "amount",
      "required": true,
      "blocking": true
    },
    {
      "id": "payment.amount.positive",
      "resourceType": "payment",
      "field": "amount",
      "op": "gt",
      "value": 0,
      "blocking": true
    },
    {
      "id": "account.email.format",
      "resourceType": "account",
      "field": "holder.email",
      "op": "pattern",
      "value": "^[^@]+@[^@]+\\.[^@]+$",
      "blocking": false
    }
  ]
}
