{
  "version": "1.0",
  "defaultUnregistered": "deny",
  "endpoints": [
    {
      "id": "create-payment",
      "method": "POST",
      "path": "/payments",
      "resourceType": "payment",
      "action": "write",
      "resourceId": {
        "from": "body",
        "path": "$._id"
      },
      "resourceSource": "pip",
      "attributes": [
        "ownerId",
        "status"
      ],
      "maskPolicy": "payment.write",
      "maskErrors": true,
      "freshness": "cached",
      "selfDescribing": true
    },
    {
      "id": "get-account",
      "method": "GET",
      "path": "/accounts/{accountId}",
      "resourceType": "account",
      "action": "read",
      "resourceId": {
        "from": "path",
        "name": "accountId"
      },
      "resourceSource": "pip",
      "attributes": [
        "ownerId",
        "region",
        "status"
      ],
      "maskPolicy": "account.read",
      "maskErrors": true,
      "freshness": "cached",
      "selfDescribing": false
    }
  ]
}
